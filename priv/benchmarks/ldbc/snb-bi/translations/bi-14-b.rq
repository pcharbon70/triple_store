# TripleStore SPARQL translation of ldbc_snb_bi:cypher/queries/bi-14.cypher
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX snb: <https://ldbcouncil.org/snb/ontology/>

SELECT ?person1__id ?person2__id ?city1__name ?score
FROM <https://ldbcouncil.org/snb/graph/snb_bi/initial>
FROM <https://ldbcouncil.org/snb/graph/snb_bi/updates>
WHERE {
  { SELECT ?p1 ?p2 ?candidateCity ?candidateCityName
           (MAX(IF(BOUND(?case1), 4, 0)) + MAX(IF(BOUND(?case2), 1, 0)) +
            MAX(IF(BOUND(?case3), 10, 0)) + MAX(IF(BOUND(?case4), 1, 0)) AS ?candidateScore)
    WHERE {
      ?c1 rdf:type snb:Place ; snb:type "Country" ; snb:name {{country1}} .
      ?candidateCity rdf:type snb:Place ; snb:type "City" ; snb:isPartOf ?c1 ; snb:name ?candidateCityName .
      ?p1 rdf:type snb:Person ; snb:isLocatedIn ?candidateCity ; (snb:knows|^snb:knows) ?p2 .
      ?c2 rdf:type snb:Place ; snb:type "Country" ; snb:name {{country2}} .
      ?p2 rdf:type snb:Person ; snb:isLocatedIn/snb:isPartOf ?c2 .
      OPTIONAL { ?case1 rdf:type snb:Comment ; snb:hasCreator ?p1 ; snb:replyOf/snb:hasCreator ?p2 . }
      OPTIONAL { ?case2 rdf:type snb:Message ; snb:hasCreator ?p1 . ?reply2 rdf:type snb:Comment ; snb:replyOf ?case2 ; snb:hasCreator ?p2 . }
      OPTIONAL { ?p1 snb:likes ?case3 . ?case3 rdf:type snb:Message ; snb:hasCreator ?p2 . }
      OPTIONAL { ?case4 rdf:type snb:Message ; snb:hasCreator ?p1 . ?p2 snb:likes ?case4 . }
    }
    GROUP BY ?p1 ?p2 ?candidateCity ?candidateCityName }
  BIND(xsd:integer(STRAFTER(STR(?p1), "/Person/")) AS ?person1__id)
  BIND(xsd:integer(STRAFTER(STR(?p2), "/Person/")) AS ?person2__id)
  FILTER NOT EXISTS {
    { SELECT ?other1 ?other2 ?otherCity ?otherCityName
           (MAX(IF(BOUND(?otherCase1), 4, 0)) + MAX(IF(BOUND(?otherCase2), 1, 0)) +
            MAX(IF(BOUND(?otherCase3), 10, 0)) + MAX(IF(BOUND(?otherCase4), 1, 0)) AS ?otherScore)
    WHERE {
      ?otherCountry1 rdf:type snb:Place ; snb:type "Country" ; snb:name {{country1}} .
      ?otherCity rdf:type snb:Place ; snb:type "City" ; snb:isPartOf ?otherCountry1 ; snb:name ?otherCityName .
      ?other1 rdf:type snb:Person ; snb:isLocatedIn ?otherCity ; (snb:knows|^snb:knows) ?other2 .
      ?otherCountry2 rdf:type snb:Place ; snb:type "Country" ; snb:name {{country2}} .
      ?other2 rdf:type snb:Person ; snb:isLocatedIn/snb:isPartOf ?otherCountry2 .
      OPTIONAL { ?otherCase1 rdf:type snb:Comment ; snb:hasCreator ?other1 ; snb:replyOf/snb:hasCreator ?other2 . }
      OPTIONAL { ?otherCase2 rdf:type snb:Message ; snb:hasCreator ?other1 . ?otherReply2 rdf:type snb:Comment ; snb:replyOf ?otherCase2 ; snb:hasCreator ?other2 . }
      OPTIONAL { ?other1 snb:likes ?otherCase3 . ?otherCase3 rdf:type snb:Message ; snb:hasCreator ?other2 . }
      OPTIONAL { ?otherCase4 rdf:type snb:Message ; snb:hasCreator ?other1 . ?other2 snb:likes ?otherCase4 . }
    }
    GROUP BY ?other1 ?other2 ?otherCity ?otherCityName }
    BIND(xsd:integer(STRAFTER(STR(?other1), "/Person/")) AS ?other1Id)
    BIND(xsd:integer(STRAFTER(STR(?other2), "/Person/")) AS ?other2Id)
    FILTER(?otherCity = ?candidateCity &&
      (?otherScore > ?candidateScore ||
       (?otherScore = ?candidateScore && ?other1Id < ?person1__id) ||
       (?otherScore = ?candidateScore && ?other1Id = ?person1__id && ?other2Id < ?person2__id)))
  }
  BIND(?candidateCityName AS ?city1__name)
  BIND(?candidateScore AS ?score)
}
ORDER BY DESC(?score) ASC(?person1__id) ASC(?person2__id)
LIMIT 100
