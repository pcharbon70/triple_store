# TripleStore SPARQL translation of ldbc_snb_bi:cypher/queries/bi-11.cypher
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX snb: <https://ldbcouncil.org/snb/ontology/>

SELECT (COUNT(*) AS ?count)
FROM <https://ldbcouncil.org/snb/graph/snb_bi/initial>
FROM <https://ldbcouncil.org/snb/graph/snb_bi/updates>
WHERE {
  ?country rdf:type snb:Place ; snb:name {{country}} .
  ?a rdf:type snb:Person ; snb:isLocatedIn/snb:isPartOf ?country .
  {
    ?k1 rdf:type snb:Relationship ; rdf:predicate snb:knows ; rdf:subject ?a ; rdf:object ?b ; snb:creationDate ?k1Date .
  } UNION {
    ?k1 rdf:type snb:Relationship ; rdf:predicate snb:knows ; rdf:subject ?b ; rdf:object ?a ; snb:creationDate ?k1Date .
  }
  ?b snb:isLocatedIn/snb:isPartOf ?country .
  {
    ?k2 rdf:type snb:Relationship ; rdf:predicate snb:knows ; rdf:subject ?b ; rdf:object ?c ; snb:creationDate ?k2Date .
  } UNION {
    ?k2 rdf:type snb:Relationship ; rdf:predicate snb:knows ; rdf:subject ?c ; rdf:object ?b ; snb:creationDate ?k2Date .
  }
  ?c snb:isLocatedIn/snb:isPartOf ?country .
  {
    ?k3 rdf:type snb:Relationship ; rdf:predicate snb:knows ; rdf:subject ?c ; rdf:object ?a ; snb:creationDate ?k3Date .
  } UNION {
    ?k3 rdf:type snb:Relationship ; rdf:predicate snb:knows ; rdf:subject ?a ; rdf:object ?c ; snb:creationDate ?k3Date .
  }
  BIND(xsd:integer(STRAFTER(STR(?a), "/Person/")) AS ?aId)
  BIND(xsd:integer(STRAFTER(STR(?b), "/Person/")) AS ?bId)
  BIND(xsd:integer(STRAFTER(STR(?c), "/Person/")) AS ?cId)
  BIND(xsd:dateTime(CONCAT(STR({{startDate}}), "T00:00:00Z")) AS ?start)
  BIND(xsd:dateTime(CONCAT(STR({{endDate}}), "T00:00:00Z")) AS ?end)
  FILTER(?aId < ?bId && ?bId < ?cId &&
         ?k1Date >= ?start && ?k1Date <= ?end &&
         ?k2Date >= ?start && ?k2Date <= ?end &&
         ?k3Date >= ?start && ?k3Date <= ?end)
}
