# TripleStore SPARQL translation of ldbc_snb_bi:cypher/queries/bi-8.cypher
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX snb: <https://ldbcouncil.org/snb/ontology/>

SELECT ?person__id ?score (COALESCE(SUM(?friendScore), 0) AS ?friendsScore)
FROM <https://ldbcouncil.org/snb/graph/snb_bi/initial>
FROM <https://ldbcouncil.org/snb/graph/snb_bi/updates>
WHERE {
  { SELECT ?scoredPerson
           (100 * COUNT(DISTINCT ?interestMarker) + COUNT(DISTINCT ?scoredMessage) AS ?individualScore)
    WHERE {
      ?scoreTag rdf:type snb:Tag ; snb:name {{tag}} .
      {
        ?scoredPerson snb:hasInterest ?scoreTag .
      } UNION {
        ?candidateMessage snb:hasTag ?scoreTag ; snb:hasCreator ?scoredPerson ; snb:creationDate ?candidateDate .
        FILTER(?candidateDate > xsd:dateTime(CONCAT(STR({{startDate}}), "T00:00:00Z")) &&
               ?candidateDate < xsd:dateTime(CONCAT(STR({{endDate}}), "T00:00:00Z")))
      }
      OPTIONAL { ?scoredPerson snb:hasInterest ?scoreTag . BIND(?scoredPerson AS ?interestMarker) }
      OPTIONAL {
        ?scoredMessage snb:hasTag ?scoreTag ; snb:hasCreator ?scoredPerson ; snb:creationDate ?scoredDate .
        FILTER(?scoredDate > xsd:dateTime(CONCAT(STR({{startDate}}), "T00:00:00Z")) &&
               ?scoredDate < xsd:dateTime(CONCAT(STR({{endDate}}), "T00:00:00Z")))
      }
    }
    GROUP BY ?scoredPerson }
  BIND(?individualScore AS ?score)
  OPTIONAL {
    ?scoredPerson (snb:knows|^snb:knows) ?friend .
    { SELECT ?friend
           (100 * COUNT(DISTINCT ?interestMarker) + COUNT(DISTINCT ?scoredMessage) AS ?friendScore)
    WHERE {
      ?scoreTag rdf:type snb:Tag ; snb:name {{tag}} .
      {
        ?friend snb:hasInterest ?scoreTag .
      } UNION {
        ?candidateMessage snb:hasTag ?scoreTag ; snb:hasCreator ?friend ; snb:creationDate ?candidateDate .
        FILTER(?candidateDate > xsd:dateTime(CONCAT(STR({{startDate}}), "T00:00:00Z")) &&
               ?candidateDate < xsd:dateTime(CONCAT(STR({{endDate}}), "T00:00:00Z")))
      }
      OPTIONAL { ?friend snb:hasInterest ?scoreTag . BIND(?friend AS ?interestMarker) }
      OPTIONAL {
        ?scoredMessage snb:hasTag ?scoreTag ; snb:hasCreator ?friend ; snb:creationDate ?scoredDate .
        FILTER(?scoredDate > xsd:dateTime(CONCAT(STR({{startDate}}), "T00:00:00Z")) &&
               ?scoredDate < xsd:dateTime(CONCAT(STR({{endDate}}), "T00:00:00Z")))
      }
    }
    GROUP BY ?friend }
  }
  BIND(xsd:integer(STRAFTER(STR(?scoredPerson), "/Person/")) AS ?person__id)
}
GROUP BY ?scoredPerson ?person__id ?score
ORDER BY DESC(?score + ?friendsScore) ASC(?person__id)
LIMIT 100
